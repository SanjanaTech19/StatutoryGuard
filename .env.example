# StatutoryGuard Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials

# Local SQLite Database (default)
DB_FILE=database/statutoryguard.db

# Supabase Cloud PostgreSQL Settings
# Get these from https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Secret key for Vault AES Encryption
VAULT_SECRET_KEY=StatutoryGuardSecretKey32BytesLong!!
