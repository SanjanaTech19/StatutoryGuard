# StatutoryGuard Environment Configuration
# Copy this file to .env and fill in your Supabase & Gateway credentials

# Local SQLite Database
DB_FILE=database/statutoryguard.db

# Supabase Cloud PostgreSQL Settings
SUPABASE_URL=https://rcjdwxiymiekxrncdbgc.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Secret key for Vault AES Encryption
VAULT_SECRET_KEY=StatutoryGuardSecretKey32BytesLong!!

# Cloud SMS Gateway Settings (Optional for 1-Click Background Silent SMS)
# Fast2SMS API Key (https://www.fast2sms.com) or Twilio API
FAST2SMS_API_KEY=your-fast2sms-api-key

# SMTP Server Settings (Optional for 1-Click Background Silent Email)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
